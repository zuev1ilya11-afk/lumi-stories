          ]
        },
        {
          "id": "gothic_ep1_rules_defy",
          "text": "«Не люблю, когда мне запрещают.»",
          "nextSceneId": "gothic_ep1_defy_rules",
          "effects": [
            {"kind": "inc", "score": "riskScore", "by": 2},
            {"kind": "setFlag", "flag": "gothic_rules_response", "value": "defy"}
          ]
