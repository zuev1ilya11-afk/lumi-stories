      "kind": "dialogue",
      "speaker": "Адриан",
      "text": "Потому что некоторые двери лучше считать стенами.",
      "beats": [
        {"speaker": "Адриан", "text": "Потому что некоторые двери лучше считать стенами.", "presentation": {"location": "Главный холл", "camera": "close", "motion": "tension"}},
        {"speaker": "Эвелин", "text": "Это не ответ.", "presentation": {"location": "Главный холл", "camera": "medium", "motion": "none"}},
        {"speaker": "Адриан", "text": "В Рейвенхолле ответы редко делают людей спокойнее.", "presentation": {"location": "Главный холл", "camera": "close", "motion": "pull-out"}}
