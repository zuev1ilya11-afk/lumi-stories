  "scenes": [
    {
      "id": "gothic_ep1_arrival",
      "kind": "narrative",
      "text": "Рейвенхолл возникает из тумана на склоне холма.",
      "beats": [
        {"text": "К вечеру дождь превращает дорогу в чёрное зеркало.", "presentation": {"location": "Дорога к Рейвенхоллу", "motion": "slow-zoom", "ambient": "rain"}},
        {"text": "За мокрым стеклом появляется поместье — слишком большое для одного человека и слишком тихое для живого дома.", "presentation": {"location": "Рейвенхолл", "camera": "wide", "motion": "push-in", "ambient": "rain"}},
        {"text": "По завещанию Эвелин должна прожить здесь тридцать дней. Тогда Рейвенхолл станет её.", "presentation": {"location": "Рейвенхолл", "camera": "medium", "motion": "none"}}
